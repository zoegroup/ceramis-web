# Cabeceras de Cloudflare Pages. La Content-Security-Policy la añade scripts/postbuild.mjs
# en dist/_headers (con los hashes de los scripts inline de la build).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Archivos con hash en el nombre: caché permanente
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Frames del hero, logos e iconos: sin hash, 30 días
/hero/*
  Cache-Control: public, max-age=2592000
/brand/*
  Cache-Control: public, max-age=2592000

# Las URLs de Cloudflare Pages (producción en *.pages.dev y previews) no se indexan:
# solo cuenta ceramisagency.com.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
