---
/** Páginas legales: índice lateral, prosa y fecha de actualización. Llevan noindex. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { formatDate } from '@/lib/blog';
import { legal } from '@/data/site';
import '@/styles/prose.css';

interface Props {
  title: string;
  seoTitle: string;
  description: string;
  path: string;
  updated: Date;
  sections: { id: string; title: string }[];
}
const { title, seoTitle, description, path, updated, sections } = Astro.props;
---

<BaseLayout title={seoTitle} description={description} noindex>
  <article class="legal">
    <header class="legal__header container">
      <Breadcrumbs
        items={[
          { label: 'Inicio', href: '/' },
          { label: title, href: path },
        ]}
      />
      <h1>{title}</h1>
      <p class="legal__updated">Última actualización: <time datetime={updated.toISOString()}>{formatDate(updated)}</time></p>
      <p class="legal__notice" role="note">
        Si tienes cualquier duda sobre este texto o sobre tus datos, escríbenos a
        <a href={`mailto:${legal.email}`}>{legal.email}</a>.
      </p>
    </header>

    <div class="legal__inner container">
      <nav class="legal__toc" aria-label="Índice">
        <p class="eyebrow">Índice</p>
        <ol role="list">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`}>{s.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal__header {
    display: grid;
    gap: var(--space-s);
    padding-top: calc(var(--header-h) + var(--space-xl));
    padding-bottom: var(--space-xl);
  }
  .legal__header :global(.breadcrumbs) {
    margin-bottom: var(--space-s);
  }
  .legal__header h1 {
    font-size: var(--fs-h2);
  }
  .legal__updated {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }
  .legal__notice {
    max-width: var(--measure);
    margin-top: var(--space-s);
    padding: var(--space-s) var(--space-m);
    background: var(--c-surface);
    border-left: 2px solid var(--c-brass);
    font-size: var(--fs-small);
  }
  .legal__inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: var(--space-2xl);
    align-items: start;
    padding-bottom: var(--space-3xl);
  }
  .legal__toc {
    position: sticky;
    top: calc(var(--header-h) + var(--space-m));
    display: grid;
    gap: var(--space-s);
    padding-top: var(--space-s);
    border-top: var(--line);
  }
  .legal__toc ol {
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--fs-small);
  }
  .legal__toc a {
    color: var(--c-ink-soft);
    text-decoration: none;
  }
  .legal__toc a:hover {
    color: var(--c-accent);
  }
  .legal :global(.prose > h2:first-child) {
    margin-top: 0;
  }
  @media (max-width: 899.98px) {
    .legal__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .legal__toc {
      position: static;
    }
  }
</style>
