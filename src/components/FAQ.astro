---
/**
 * Acordeón accesible con <details>/<summary> + JSON-LD FAQPage.
 * La apertura se anima solo donde el navegador soporta ::details-content e interpolate-size;
 * en el resto abre al instante. Sin JS.
 */
import type { FaqItem } from '@/data/faq';

interface Props {
  items: FaqItem[];
}
const { items } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item" data-reveal>
        <summary>
          <span class="faq__q">{item.q}</span>
          <span class="faq__icon" aria-hidden="true" />
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

<style>
  .faq {
    border-top: var(--line);
  }
  .faq__item {
    border-bottom: var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    min-height: 48px;
    padding-block: var(--space-m);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font-size: var(--fs-h4);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color var(--dur-fast) ease;
  }
  summary:hover .faq__q {
    color: var(--c-accent);
  }
  /* + que gira a − */
  .faq__icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--c-ink);
    transition: transform 0.4s var(--ease-out);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__a {
    padding-bottom: var(--space-l);
    color: var(--c-ink-soft);
  }

  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq__item::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.5s var(--ease-out),
        content-visibility 0.5s allow-discrete;
    }
    .faq__item[open]::details-content {
      height: auto;
    }
  }
</style>
