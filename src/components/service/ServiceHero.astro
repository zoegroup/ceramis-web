---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import { Picture } from 'astro:assets';
import CtaNote from '@/components/CtaNote.astro';
import { euros, serviceHref, waitlistHref, type Service } from '@/data/services';
import { emphasize } from '@/lib/text';

interface Props {
  service: Service;
}
const { service } = Astro.props;
---

<section class="service-hero">
  <div class="service-hero__crumbs container">
    <Breadcrumbs
      items={[
        { label: 'Inicio', href: '/' },
        { label: 'Servicios', href: '/servicios/' },
        { label: service.name, href: serviceHref(service) },
      ]}
    />
  </div>
  <div class="service-hero__inner container">
    <div class="service-hero__text">
      <p class="eyebrow">
        {service.name}
        {!service.available && <span class="service-hero__badge">Próximamente</span>}
      </p>
      <h1 set:html={emphasize(service.h1)} />
      <p class="lead">{service.intro}</p>
      <p class="service-hero__price">
        <span>Desde</span> <strong data-count={service.fromPrice}>{euros(service.fromPrice)}</strong><span>/mes · sin IVA</span>
      </p>
      <div class="service-hero__actions">
        {
          service.available ? (
            <Button href="#diagnostico" size="lg">
              {service.cta}
            </Button>
          ) : (
            <Button href={waitlistHref(service)} size="lg">
              Únete a la lista de espera
            </Button>
          )
        }
        <Button href="#precios" variant="secondary" size="lg">Ver precios</Button>
      </div>
      <CtaNote />
    </div>
    <div class="service-hero__media" transition:name={`servicio-media-${service.slug}`} data-parallax>
      <Picture
        src={service.image}
        alt={service.imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200]}
        sizes="(min-width: 900px) 40vw, 100vw"
        loading="eager"
        fetchpriority="high"
        style={service.imagePosition ? `object-position: ${service.imagePosition}` : undefined}
      />
    </div>
  </div>
</section>

<style>
  .service-hero {
    padding-top: calc(var(--header-h) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }
  .service-hero__crumbs {
    margin-bottom: var(--space-l);
  }
  .service-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .service-hero__text {
    display: grid;
    gap: var(--space-m);
  }
  .service-hero__text h1 {
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4.5rem);
  }
  .service-hero__badge {
    margin-left: var(--space-xs);
    padding: 0.2em 0.7em;
    border: 1px solid var(--c-accent);
    border-radius: var(--radius);
    color: var(--c-accent);
  }
  .service-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }
  .service-hero__price {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    color: var(--c-ink-soft);
  }
  .service-hero__price strong {
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }
  .service-hero__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--c-sand);
    border: var(--line);
    border-radius: var(--radius);
  }
  .service-hero__media :global(picture) {
    display: block;
    height: 100%;
  }
  .service-hero__media :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
    will-change: transform;
  }
  @media (max-width: 899.98px) {
    .service-hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
    .service-hero__media {
      aspect-ratio: 3 / 2;
      order: -1;
    }
  }
  @media (max-width: 479.98px) {
    .service-hero__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
