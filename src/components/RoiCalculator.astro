---
/**
 * Calculadora de ROI de Reservas telefónicas con IA.
 *   reservas/semana = llamadas perdidas × % que reservaría
 *   € por reserva   = comensales × ticket por comensal   (por defecto 2 × 18 € = 36 €)
 *   al mes = semanal × 52 / 12 · al año = semanal × 52
 * Sin JS se ve el cálculo con los valores por defecto (hecho en el servidor).
 */
import { COMENSALES_POR_RESERVA, TICKET_POR_PERSONA } from '@/data/services/shared';

interface Field {
  name: 'llamadas' | 'porcentaje' | 'comensales' | 'ticket';
  label: string;
  hint: string;
  min: number;
  max: number;
  step: number;
  value: number;
  unit: string;
}

// Valores por defecto: 18 € por persona y 2 personas por reserva (dato del cliente).
// Llamadas perdidas y % de conversión son orientativos. [VALIDAR]
const fields: Field[] = [
  { name: 'llamadas', label: 'Llamadas perdidas por semana', hint: 'Las que nadie coge: en servicio, fuera de horario o en tu día de cierre.', min: 0, max: 150, step: 1, value: 20, unit: '' },
  { name: 'porcentaje', label: 'De ellas, % que acabaría reservando', hint: 'No todas las llamadas son para reservar.', min: 0, max: 100, step: 5, value: 40, unit: '%' },
  { name: 'comensales', label: 'Comensales por reserva', hint: 'Lo habitual son 2 personas.', min: 1, max: 12, step: 0.5, value: COMENSALES_POR_RESERVA, unit: '' },
  { name: 'ticket', label: 'Ticket medio por comensal', hint: 'Lo que gasta de media cada persona.', min: 5, max: 150, step: 1, value: TICKET_POR_PERSONA, unit: '€' },
];

const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0, useGrouping: 'always' });
const num = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 });
const v = Object.fromEntries(fields.map((f) => [f.name, f.value])) as Record<Field['name'], number>;
const perBooking = v.comensales * v.ticket;
const bookingsWeek = v.llamadas * (v.porcentaje / 100);
const weekly = bookingsWeek * perBooking;
const monthly = (weekly * 52) / 12;
const yearly = weekly * 52;
import Button from '@/components/Button.astro';
---

<div class="roi" data-roi>
  <form class="roi__inputs" data-roi-form>
    {
      fields.map((f) => (
        <div class="roi__field">
          <div class="roi__row">
            <label for={`roi-${f.name}`}>{f.label}</label>
            <span class="roi__number">
              <input
                id={`roi-${f.name}`}
                name={f.name}
                type="number"
                inputmode="decimal"
                min={f.min}
                max={f.max}
                step={f.step}
                value={f.value}
                aria-describedby={`roi-${f.name}-hint`}
                data-roi-number
              />
              <span class="roi__unit" aria-hidden="true">{f.unit}</span>
            </span>
          </div>
          <input
            class="roi__range"
            type="range"
            name={`${f.name}-range`}
            min={f.min}
            max={f.max}
            step={f.step}
            value={f.value}
            aria-label={f.label}
            data-roi-range={f.name}
            tabindex="-1"
          />
          <p class="roi__hint" id={`roi-${f.name}-hint`}>
            {f.hint}
          </p>
        </div>
      ))
    }
  </form>

  <div class="roi__results">
    <p class="eyebrow">Facturación que podrías recuperar</p>
    <dl class="roi__main">
      <div>
        <dt>Al mes</dt>
        <dd data-roi-out="monthly">{eur.format(monthly)}</dd>
      </div>
      <div>
        <dt>Al año</dt>
        <dd data-roi-out="yearly">{eur.format(yearly)}</dd>
      </div>
    </dl>
    <dl class="roi__detail">
      <div>
        <dt>Reservas recuperadas por semana</dt>
        <dd data-roi-out="bookings">{num.format(bookingsWeek)}</dd>
      </div>
      <div>
        <dt>Ticket medio por reserva</dt>
        <dd data-roi-out="perBooking">{eur.format(perBooking)}</dd>
      </div>
      <div>
        <dt>Por semana</dt>
        <dd data-roi-out="weekly">{eur.format(weekly)}</dd>
      </div>
    </dl>
    <p class="visually-hidden" aria-live="polite" data-roi-live></p>
    <p class="roi__note">
      Es una estimación orientativa con los datos que tú introduces, no una promesa de facturación.
      Calculamos el mes como 52 semanas entre 12.
    </p>
    <Button href="#diagnostico" size="lg" class="roi__cta" data-roi-cta data-plan={`Agente de IA · calculadora: ${eur.format(monthly)}/mes`}>
      <span>Recupera esos <span data-roi-out="cta">{eur.format(monthly)}</span>/mes</span>
    </Button>
  </div>
</div>

<style>
  .roi {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    background: var(--c-surface);
    border: var(--line);
    border-radius: var(--radius);
  }
  .roi__inputs {
    display: grid;
    gap: var(--space-l);
    padding: clamp(var(--space-m), 4vw, var(--space-xl));
  }
  .roi__field {
    display: grid;
    gap: var(--space-2xs);
  }
  .roi__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-s);
  }
  .roi__row label {
    font-weight: 500;
  }
  .roi__number {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    font-weight: 500;
  }
  .roi__unit {
    min-width: 1.1em;
  }
  .roi__number input {
    width: 5.5rem;
    min-height: 44px;
    padding: 0.4rem 0.6rem;
    background: var(--c-bg);
    border: 1px solid var(--c-ink-soft);
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 500;
    text-align: right;
  }
  .roi__number input:focus-visible {
    outline-offset: 0;
    border-color: var(--c-accent);
  }
  .roi__range {
    width: 100%;
    height: 28px;
    accent-color: var(--c-accent);
    cursor: pointer;
  }
  .roi__hint {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  .roi__results {
    display: grid;
    align-content: start;
    gap: var(--space-m);
    padding: clamp(var(--space-m), 4vw, var(--space-xl));
    background: var(--c-bg);
    border-left: var(--line);
  }
  .roi__main {
    display: grid;
    gap: var(--space-m);
  }
  .roi__main div {
    display: grid;
    gap: var(--space-3xs);
    padding-bottom: var(--space-m);
    border-bottom: 2px solid var(--c-brass);
  }
  .roi__main dt {
    color: var(--c-ink-soft);
  }
  .roi__main dd {
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--c-accent);
    font-variant-numeric: tabular-nums;
  }
  .roi__detail div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-2xs);
    border-bottom: var(--line);
    font-size: var(--fs-small);
  }
  .roi__detail dt {
    color: var(--c-ink-soft);
  }
  .roi__detail dd {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .roi :global(.roi__cta) {
    width: 100%;
  }
  .roi__note {
    font-size: var(--fs-small);
    color: var(--c-ink-soft);
  }

  @media (max-width: 899.98px) {
    .roi {
      grid-template-columns: 1fr;
    }
    .roi__results {
      border-left: 0;
      border-top: var(--line);
    }
  }
</style>

<script>
  const eur = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0, useGrouping: 'always' });
  const num = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 });
  let abort: AbortController | null = null;

  function setup() {
    abort?.abort();
    const root = document.querySelector<HTMLElement>('[data-roi]');
    if (!root) return;
    abort = new AbortController();
    const { signal } = abort;

    const form = root.querySelector<HTMLFormElement>('[data-roi-form]')!;
    const numbers = Array.from(root.querySelectorAll<HTMLInputElement>('[data-roi-number]'));
    const ranges = Array.from(root.querySelectorAll<HTMLInputElement>('[data-roi-range]'));
    const out = (key: string) => root.querySelector<HTMLElement>(`[data-roi-out="${key}"]`)!;
    const live = root.querySelector<HTMLElement>('[data-roi-live]')!;
    const animate = () => document.documentElement.classList.contains('motion-ok');

    // Los sliders son un atajo visual del campo numérico (que es el control accesible).
    ranges.forEach((r) => r.removeAttribute('tabindex'));

    const read = (name: string) => {
      const input = numbers.find((n) => n.name === name)!;
      const value = Number(input.value.replace(',', '.'));
      return Number.isFinite(value) ? Math.min(Math.max(value, Number(input.min)), Number(input.max)) : 0;
    };

    const shown = { monthly: 0, yearly: 0 };
    let raf = 0;
    let liveTimer = 0;

    const countTo = (target: { monthly: number; yearly: number }) => {
      cancelAnimationFrame(raf);
      if (!animate()) {
        Object.assign(shown, target);
        out('monthly').textContent = eur.format(target.monthly);
        out('yearly').textContent = eur.format(target.yearly);
        return;
      }
      const from = { ...shown };
      const start = performance.now();
      const duration = 800;
      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        const e = 1 - Math.pow(1 - t, 3); // power3.out
        shown.monthly = from.monthly + (target.monthly - from.monthly) * e;
        shown.yearly = from.yearly + (target.yearly - from.yearly) * e;
        out('monthly').textContent = eur.format(shown.monthly);
        out('yearly').textContent = eur.format(shown.yearly);
        if (t < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    const update = () => {
      const llamadas = read('llamadas');
      const porcentaje = read('porcentaje');
      const comensales = read('comensales');
      const ticket = read('ticket');
      const perBooking = comensales * ticket;
      const bookings = llamadas * (porcentaje / 100);
      const weekly = bookings * perBooking;
      const target = { monthly: (weekly * 52) / 12, yearly: weekly * 52 };

      out('bookings').textContent = num.format(bookings);
      out('perBooking').textContent = eur.format(perBooking);
      out('weekly').textContent = eur.format(weekly);
      out('cta').textContent = eur.format(target.monthly);
      root.querySelector<HTMLElement>('[data-roi-cta]')!.dataset.plan = `Agente de IA · calculadora: ${eur.format(target.monthly)}/mes`;
      countTo(target);

      // Solo se anuncia la cifra final, cuando el usuario deja de tocar.
      clearTimeout(liveTimer);
      liveTimer = window.setTimeout(() => {
        live.textContent = `Podrías recuperar unos ${eur.format(target.monthly)} al mes y ${eur.format(target.yearly)} al año.`;
      }, 700);
    };

    form.addEventListener('submit', (e) => e.preventDefault(), { signal });
    numbers.forEach((input) => {
      const range = ranges.find((r) => r.dataset.roiRange === input.name)!;
      input.addEventListener('input', () => {
        range.value = String(read(input.name));
        update();
      }, { signal });
      // Al salir, corrige valores fuera de rango.
      input.addEventListener('change', () => {
        input.value = String(read(input.name));
      }, { signal });
      range.addEventListener('input', () => {
        input.value = range.value;
        update();
      }, { signal });
    });

    // Estado inicial (el servidor ya pintó los valores por defecto).
    shown.monthly = (read('llamadas') * (read('porcentaje') / 100) * read('comensales') * read('ticket') * 52) / 12;
    shown.yearly = shown.monthly * 12;
    signal.addEventListener('abort', () => {
      cancelAnimationFrame(raf);
      clearTimeout(liveTimer);
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
