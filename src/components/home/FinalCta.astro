---
import Button from '@/components/Button.astro';
import CTAForm from '@/components/CTAForm.astro';
import { site, whatsappHref } from '@/data/site';
---

<section id="diagnostico" class="final-cta" aria-labelledby="diagnostico-titulo">
  <div class="final-cta__inner container">
    <div class="final-cta__intro" data-reveal>
      <p class="eyebrow">Diagnóstico gratis</p>
      <h2 id="diagnostico-titulo" class="final-cta__title">¿Hablamos de tu <em>restaurante</em>?</h2>
      <p class="lead">
        En 30 minutos vemos dónde se te escapan clientes y qué haríamos primero. Sin compromiso y sin
        humo.
      </p>
      <div class="final-cta__alt">
        <p>¿Prefieres escribirnos?</p>
        <Button href={whatsappHref} variant="secondary" size="lg" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"
            ><path
              d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 001.8-1.2 2.2 2.2 0 00.1-1.2c0-.1-.2-.2-.4-.3z"
            ></path></svg
          >
          Escríbenos por WhatsApp
        </Button>
        <p class="final-cta__contact">
          o llámanos al <a href={`tel:${site.contact.phone}`}>{site.contact.phone}</a>
        </p>
      </div>
    </div>

    <div class="final-cta__form" data-reveal>
      <CTAForm id="diagnostico" />
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: var(--space-3xl);
    background: var(--c-surface);
    border-top: var(--line);
    scroll-margin-top: var(--header-h);
  }
  .final-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .final-cta__intro {
    display: grid;
    gap: var(--space-m);
  }
  .final-cta__title {
    font-size: var(--fs-h1);
  }
  .final-cta__alt {
    display: grid;
    justify-items: start;
    gap: var(--space-s);
    margin-top: var(--space-l);
    padding-top: var(--space-l);
    border-top: var(--line);
  }
  .final-cta__contact {
    color: var(--c-ink-soft);
  }
  .final-cta__form {
    padding: clamp(var(--space-m), 3vw, var(--space-xl));
    background: var(--c-bg);
    border: var(--line);
    border-radius: var(--radius);
  }
  @media (max-width: 899.98px) {
    .final-cta__inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }
</style>
