---
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { services } from '@/data/services';
---

<section id="servicios" class="services" aria-labelledby="servicios-titulo">
  <div class="container">
    <SectionHeader eyebrow="Servicios" id="servicios-titulo">
      <Fragment slot="title">Cuatro formas de <em>llenar</em> tu restaurante.</Fragment>
      Captar clientes nuevos, no perder ni una reserva y conseguir que vuelvan. Todo desde un mismo panel.
    </SectionHeader>
  </div>

  <div class="services__track" data-services-track>
    <ul class="services__grid" role="list">
      {
        services.map((service, i) => (
          <li class="services__item">
            <ServiceCard service={service} index={i} />
          </li>
        ))
      }
    </ul>
  </div>
  <p class="services__count container" aria-hidden="true" data-services-count>
    <span data-services-current>1</span> / {services.length}
  </p>
</section>

<style>
  .services {
    padding-block: var(--space-3xl);
    background: var(--c-sand);
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }
  .services__count {
    display: none;
  }

  /* Móvil: carrusel con scroll-snap, la siguiente tarjeta asoma */
  @media (max-width: 767.98px) {
    .services__track {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .services__track::-webkit-scrollbar {
      display: none;
    }
    .services__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(82vw, 22rem);
      gap: var(--space-s);
      width: max-content;
      padding-inline: var(--gutter);
      padding-block: 4px; /* deja ver el anillo de foco */
    }
    .services__item {
      scroll-snap-align: start;
    }
    .services__count {
      display: block;
      margin-top: var(--space-m);
      font-size: var(--fs-small);
      font-weight: 500;
      letter-spacing: 0.08em;
      color: var(--c-ink-soft);
    }
  }
</style>

<script>
  // Contador "1 / 4" del carrusel móvil. Sin dependencias: solo lee el scroll horizontal.
  let abort: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    abort?.abort();
    abort = new AbortController();
    const track = document.querySelector<HTMLElement>('[data-services-track]');
    const current = document.querySelector<HTMLElement>('[data-services-current]');
    if (!track || !current) return;
    const items = Array.from(track.querySelectorAll<HTMLElement>('.services__item'));
    const update = () => {
      const left = track.getBoundingClientRect().left;
      let best = 0;
      let bestDist = Infinity;
      items.forEach((item, i) => {
        const d = Math.abs(item.getBoundingClientRect().left - left);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      current.textContent = String(best + 1);
    };
    track.addEventListener('scroll', update, { passive: true, signal: abort.signal });
  });
</script>
