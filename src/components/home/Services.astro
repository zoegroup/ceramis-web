---
import SectionHeader from '@/components/SectionHeader.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { services } from '@/data/services';
---

<section id="servicios" class="services" aria-labelledby="servicios-titulo">
  <div class="container">
    <SectionHeader eyebrow="Servicios" id="servicios-titulo">
      <Fragment slot="title">Cuatro formas de <em>llenar</em> tu restaurante.</Fragment>
      Captar clientes nuevos, no perder ni una reserva y conseguir que vuelvan. Todo desde un mismo panel.
    </SectionHeader>
  </div>

  <div class="services__track" data-services-track>
    <ul class="services__grid" role="list">
      {
        services.map((service, i) => (
          <li class="services__item">
            <ServiceCard service={service} index={i} />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="services__controls container" data-services-controls>
    <ol class="services__dots" role="list" aria-hidden="true">
      {services.map((_, i) => <li class:list={['services__dot', i === 0 && 'is-active']} />)}
    </ol>
    <p class="visually-hidden" aria-live="polite" data-services-status></p>
    <div class="services__arrows">
      <button type="button" class="services__arrow" data-services-prev aria-label="Servicio anterior" disabled>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" class="services__arrow" data-services-next aria-label="Servicio siguiente">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--space-3xl);
    background: var(--c-sand);
  }
  .services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-m);
    width: min(100% - 2 * var(--gutter), var(--container));
    margin-inline: auto;
  }
  .services__controls {
    display: none;
  }

  /* Móvil: carrusel con scroll-snap, la siguiente tarjeta asoma */
  @media (max-width: 767.98px) {
    .services__track {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .services__track::-webkit-scrollbar {
      display: none;
    }
    .services__grid {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: min(calc(100vw - 2 * var(--gutter) - 2.25rem), 24rem);
      gap: var(--space-s);
      width: max-content;
      padding-inline: var(--gutter);
      padding-block: 4px; /* deja ver el anillo de foco */
    }
    .services__item {
      scroll-snap-align: start;
    }
    .services__controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-m);
      margin-top: var(--space-m);
    }
    .services__dots {
      display: flex;
      gap: 6px;
    }
    .services__dot {
      width: 1.5rem;
      height: 2px;
      background: var(--c-stone);
      transition:
        width 0.4s var(--ease-out),
        background-color 0.4s ease;
    }
    .services__dot.is-active {
      width: 3rem;
      background: var(--c-accent);
    }
    .services__arrows {
      display: flex;
      gap: var(--space-xs);
    }
    .services__arrow {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--c-ink);
      border-radius: var(--radius);
      background: transparent;
      color: var(--c-ink);
      font-size: 1.1rem;
      cursor: pointer;
      transition:
        background-color var(--dur-fast) ease,
        color var(--dur-fast) ease,
        opacity var(--dur-fast) ease;
    }
    .services__arrow:hover:not(:disabled) {
      background: var(--c-ink);
      color: var(--c-surface);
    }
    .services__arrow:disabled {
      opacity: 0.35;
      cursor: default;
    }
  }
</style>

<script>
  // Carrusel móvil: indicador de posición y flechas. Sin dependencias: solo lee el scroll horizontal.
  let abort: AbortController | null = null;

  document.addEventListener('astro:page-load', () => {
    abort?.abort();
    abort = new AbortController();
    const { signal } = abort;
    const track = document.querySelector<HTMLElement>('[data-services-track]');
    const controls = document.querySelector<HTMLElement>('[data-services-controls]');
    if (!track || !controls) return;
    const items = Array.from(track.querySelectorAll<HTMLElement>('.services__item'));
    const dots = Array.from(controls.querySelectorAll<HTMLElement>('.services__dot'));
    const prev = controls.querySelector<HTMLButtonElement>('[data-services-prev]')!;
    const next = controls.querySelector<HTMLButtonElement>('[data-services-next]')!;
    const status = controls.querySelector<HTMLElement>('[data-services-status]')!;
    let current = 0;

    const nearest = () => {
      const left = track.getBoundingClientRect().left;
      let best = 0;
      let bestDist = Infinity;
      items.forEach((item, i) => {
        const d = Math.abs(item.getBoundingClientRect().left - left);
        if (d < bestDist) {
          bestDist = d;
          best = i;
        }
      });
      // Al final del scroll la última tarjeta no llega al borde izquierdo: cuenta como activa.
      if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) best = items.length - 1;
      return best;
    };
    const update = () => {
      const i = nearest();
      if (i === current && dots[i]?.classList.contains('is-active')) return;
      current = i;
      dots.forEach((d, j) => d.classList.toggle('is-active', j === i));
      prev.disabled = i === 0;
      next.disabled = i === items.length - 1;
      status.textContent = `Servicio ${i + 1} de ${items.length}`;
    };
    const go = (i: number) => {
      const target = items[Math.max(0, Math.min(items.length - 1, i))];
      if (!target) return;
      const smooth = document.documentElement.classList.contains('motion-ok');
      const pad = parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
      const left = track.scrollLeft + target.getBoundingClientRect().left - track.getBoundingClientRect().left - pad;
      track.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
    };

    track.addEventListener('scroll', update, { passive: true, signal });
    prev.addEventListener('click', () => go(current - 1), { signal });
    next.addEventListener('click', () => go(current + 1), { signal });
    update();
  });
</script>
